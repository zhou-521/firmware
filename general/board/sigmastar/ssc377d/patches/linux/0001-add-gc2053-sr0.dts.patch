+};
+/* ============ GC2053 适配 (SSC377D / infinity6c, 星宸私有 ISP/MIPI) ============
+ * 本平台不使用 Linux Media/V4L2，不添加 camera/port/endpoint 节点。
+ * GC2053 为外置模块 sensor_gc2053_mipi.ko，chmap 选择绑定的 sensor pad。
+ *
+ * vif_srX_*_mode 是 VIF 传感器 pad 控制器配置（SR_IO 专用引脚，不走 padmux 表）。
+ * 以下取值逐项对齐原厂出厂固件 DTB（mtd2 备份，原厂样机在该配置下可出图）：
+ *   vif_sr0_mipi_mode     2 -> 0
+ *   vif_sr0_mipi_rst_mode 3 -> 1
+ *   vif_sr2_mipi_mode     3 -> 0
+ *   vif_sr2_mipi_rst_mode 1 -> 3
+ * csi：GC2053 为 2-lane，sr0/sr2 均按 2-lane 配置，chmap 决定实际通路。
+ * sensorif：两组 MIPI I2C 都映射到 i2c-1（与原厂一致）。
+ * 加载脚本另含原厂 GPIO43/GPIO42 传感器上电时序（demo.sh 移植）。
+ * ========================================================================== */
+&vif {
+    vif_sr0_mipi_mode     = <0>;
+    vif_sr0_mipi_rst_mode = <1>;
+    vif_sr2_mipi_mode     = <0>;
+    vif_sr2_mipi_rst_mode = <3>;
+};
+
+&csi {
+    csi_sr0_lane_num     = <2>;
+    csi_sr0_lane_select  = <0 1 2>;
+    csi_sr0_lane_pn_swap = <0 0 0>;
+
+    csi_sr2_lane_num     = <2>;
+    csi_sr2_lane_select  = <0 1 2>;
+    csi_sr2_lane_pn_swap = <0 0 0>;
+};
+
+&sensorif {
+    sensorif_mipi_grp0_i2c = <1>;
+    sensorif_mipi_grp2_i2c = <1>;
+};
